            "defines": [
                "CORE_CM4",
                "USE_HAL_DRIVER",
                "STM32H757xx",
                "USE_PWR_LDO_SUPPLY",
                "METAL_INTERNAL",
                "METAL_MAX_DEVICE_REGIONS=2",
                "RPMSG_BUFFER_SIZE=512",
                "VIRTIO_SLAVE_ONLY",
                "NO_ATOMIC_64_SUPPORT"
